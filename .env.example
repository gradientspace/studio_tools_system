# Studio Tools System server settings. Copy to .env (gitignored) and edit.
# Real environment variables override these.

# --- Tools Agent chat ---------------------------------------------------------
# Which coding agent powers the in-Studio "Tools Agent" chat: claude or codex.
STUDIO_AGENT=claude

# Optional model override, passed to the agent as-is (agent-specific name).
# STUDIO_AGENT_MODEL=

# Claude Code
# CLAUDE_BIN=claude
# Permission mode. Unset = your own Claude Code settings apply.
# e.g. acceptEdits (restrict to edits), bypassPermissions (allow everything)
# CLAUDE_PERMISSION_MODE=

# Codex
# CODEX_BIN=codex
# Sandbox for Codex's commands: read-only, workspace-write (default: edit the
# repo and local packs, no network), danger-full-access (everything)
# CODEX_SANDBOX=workspace-write

# --- Server -------------------------------------------------------------------
# PORT=34873
